{
  "name": "runwayhub",
  "framework": "Laravel 10/11",
  "database": "MySQL/MariaDB (5.7+)",
  "features": [
    "Session Auth",
    "Eloquent ORM",
    "Blade Templates"
  ],
  "install_steps": [
    "composer install --optimize-autoloader",
    "cp .env.example .env && php artisan key:generate",
    "php migrate:fresh --seed"
  ]
}